*.ogg
!tools/weather_audio/*.ogg
# Agent working folders: reverse-engineering extracts (decoded retail audio, decompiled scripts) must never publish.
/.superpowers/
!/crates/skate-data/tests/fixtures/retail-collision.rwcmset
.env
.env.*
*.pem
*.key

